{
  "name": "analise-pipeline-vendas",
  "version": "0.1.0",
  "private": true,
  "description": "Análise gerencial comparativa do pipeline de vendas AC CyberPro (2025 × 2026) com simulação Monte Carlo",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "vitest run && node --test \".claude/hooks/*.test.mjs\"",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "docs:generate": "node scripts/docs-generate.mjs",
    "report": "node --disable-warning=ExperimentalWarning scripts/report.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "db:import": "node --disable-warning=ExperimentalWarning scripts/db-import.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fomantic-ui-css": "^2.9.4",
    "jquery": "^3.7.1",
    "simple-statistics": "^7.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "supertest": "^7.3.0",
    "vitest": "^3.2.7"
  }
}
